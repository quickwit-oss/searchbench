{
  "analytics": {
    "reporting_enabled": false
  },
  "auth_enabled": false,
  "chunk_store_config": {
    "chunk_cache_config": {
      "embedded_cache": {
        "enabled": false
      }
    },
    "chunk_cache_config_l2": {
      "embedded_cache": {
        "enabled": false
      }
    }
  },
  "common": {
    "compactor_grpc_address": "127.0.0.1:9096",
    "instance_addr": "127.0.0.1",
    "path_prefix": "/data",
    "replication_factor": 1,
    "ring": {
      "kvstore": {
        "store": "inmemory"
      }
    },
    "storage": {
      "s3": {
        "bucketnames": "<bucket>",
        "region": "us-east-1"
      }
    }
  },
  "compactor": {
    "compaction_interval": "1m",
    "retention_enabled": false,
    "working_directory": "/data/compactor"
  },
  "frontend": {
    "scheduler_address": "127.0.0.1:9096"
  },
  "frontend_worker": {
    "scheduler_address": "127.0.0.1:9096"
  },
  "ingester": {
    "chunk_encoding": "snappy",
    "chunk_idle_period": "30s",
    "chunk_retain_period": "0s",
    "chunk_target_size": 1572864,
    "lifecycler": {
      "min_ready_duration": "0s"
    },
    "max_chunk_age": "2h",
    "wal": {
      "dir": "/data/wal",
      "enabled": true,
      "flush_on_shutdown": true
    }
  },
  "limits_config": {
    "allow_structured_metadata": true,
    "deletion_mode": "disabled",
    "discover_log_levels": false,
    "discover_service_name": [],
    "increment_duplicate_timestamp": false,
    "ingestion_burst_size_mb": 256,
    "ingestion_rate_mb": 128,
    "max_global_streams_per_user": 0,
    "max_line_size": "1MB",
    "max_line_size_truncate": false,
    "max_query_series": 100000,
    "max_streams_per_user": 0,
    "per_stream_rate_limit": "32MB",
    "per_stream_rate_limit_burst": "64MB",
    "query_timeout": "600s",
    "reject_old_samples": false,
    "split_instant_metric_queries_by_interval": "1h",
    "split_queries_by_interval": "15m",
    "tsdb_max_bytes_per_shard": "600MB",
    "tsdb_max_query_parallelism": 32,
    "unordered_writes": true
  },
  "querier": {
    "max_concurrent": 16,
    "query_store_only": true
  },
  "query_range": {
    "cache_instant_metric_results": false,
    "cache_results": false
  },
  "query_scheduler": {
    "use_scheduler_ring": false
  },
  "schema_config": {
    "configs": [
      {
        "from": "2020-01-01",
        "index": {
          "period": "24h",
          "prefix": "index_"
        },
        "object_store": "s3",
        "schema": "v13",
        "store": "tsdb"
      }
    ]
  },
  "server": {
    "grpc_listen_address": "127.0.0.1",
    "grpc_listen_port": 9096,
    "http_listen_address": "127.0.0.1",
    "http_listen_port": 3100,
    "http_server_read_timeout": "600s",
    "http_server_write_timeout": "600s"
  },
  "storage_config": {
    "object_prefix": "searchbench/loki/s3-1b-20261115T123351Z/",
    "tsdb_shipper": {
      "active_index_directory": "/data/tsdb-index",
      "cache_location": "/data/tsdb-cache"
    }
  }
