#!/usr/bin/env bash
# Launch OpenSearch container; idempotent via ./check
set -euo pipefail
cd "$(dirname "$0")"

: "${OS_PORT:=9200}"
: "${OS_DATA_DIR:=${PWD}/os-data}"
: "${OS_IMAGE:=opensearchproject/opensearch:3.8.0}"
: "${OS_CONTAINER:=searchbench-os}"
# JVM heap; SEARCHBENCH_HEAP keeps ES/OS equal (both), OS_HEAP overrides one
: "${OS_HEAP:=${SEARCHBENCH_HEAP:-30g}}"
# OS_STORAGE=s3: the node also has the `warm` role (searchable snapshots) and an S3
# snapshot repository; ./load mounts the index from S3 as a remote_snapshot. Needs the
# image with the repository-s3 plugin (./install builds it). See README "S3".
: "${OS_STORAGE:=local}"
case "$OS_STORAGE" in
    local) s3_env=() ;;
    s3)    [[ "$OS_IMAGE" == */opensearch:* ]] && OS_IMAGE="searchbench/opensearch-s3:${OS_IMAGE##*:}"
           s3_env=(-e "node.roles=cluster_manager,data,ingest,warm"
                   -e "node.search.cache.size=${OS_FILE_CACHE_SIZE:-200gb}"
                   -e "cluster.filecache.remote_data_ratio=${OS_REMOTE_DATA_RATIO:-5}"
                   -e "thread_pool.force_merge.size=${OS_FORCE_MERGE_THREADS:-8}"
                   -e "AWS_REGION=${AWS_REGION:-us-east-1}") ;;
    *) echo "OS_STORAGE must be local or s3, got: $OS_STORAGE" >&2; exit 1 ;;
esac
# S3 mode: the searchable-snapshot file cache (8 MiB blocks fetched from S3, on local
# disk) is a data cache. It survives restarts, `_cache/clear?file=true` only drops blocks
# no open reader holds, and a remote_snapshot index cannot be closed: so ./start empties
# it while the node is down (OS_FILE_CACHE_WIPE=on, default). With the driver's restart
# before every query, try 1 reads its data from S3; tries 2-3 find it in the file cache.
if [[ "$OS_STORAGE" == s3 && "${OS_FILE_CACHE_WIPE:-on}" == on ]] && ! ./check >/dev/null 2>&1; then
    cache_dir="${OS_DATA_DIR}/data/nodes/0/cache"
    if [[ -d "$cache_dir" ]]; then rm -rf "$cache_dir" 2>/dev/null || sudo -n rm -rf "$cache_dir"; fi
fi

if ./check >/dev/null 2>&1; then
    echo "OS already up on :${OS_PORT}"
    exit 0
fi

mkdir -p "$OS_DATA_DIR/data" "$OS_DATA_DIR/logs"

# Drop a container built from a different image, so an OS_IMAGE bump actually
# takes effect -- the plain `docker start` below would keep the old version.
if docker inspect "$OS_CONTAINER" >/dev/null 2>&1 \
   && [[ "$(docker inspect -f '{{.Config.Image}}' "$OS_CONTAINER")" != "$OS_IMAGE" ]]; then
    echo "container was built from a different image; recreating for ${OS_IMAGE}"
    docker rm -f "$OS_CONTAINER" >/dev/null
fi

# Restart existing container, else create fresh
if docker inspect "$OS_CONTAINER" >/dev/null 2>&1; then
    docker start "$OS_CONTAINER" >/dev/null
else
    # Only data dir bind-mounted; GC logs stay in container (docker logs)
    # --network host: no NAT; bind via http.port, http.host=0.0.0.0
    docker run -d \
        --name "$OS_CONTAINER" \
        --network host \
        -e discovery.type=single-node \
        -e "http.port=${OS_PORT}" \
        -e "http.host=0.0.0.0" \
        -e DISABLE_SECURITY_PLUGIN=true \
        "${s3_env[@]}" \
        -e bootstrap.memory_lock=true \
        -e "OPENSEARCH_JAVA_OPTS=-Xms${OS_HEAP} -Xmx${OS_HEAP}" \
        --ulimit memlock=-1:-1 \
        --ulimit nofile=65535:65535 \
        -v "${OS_DATA_DIR}/data:/usr/share/opensearch/data" \
        "$OS_IMAGE" >/dev/null
fi

for _ in $(seq 1 180); do
    if ./check >/dev/null 2>&1; then
        echo "OS up on :${OS_PORT} (backend=docker)"
        exit 0
    fi
    sleep 1
done

echo "OS did not become healthy within 180s." >&2
docker logs --tail 50 "$OS_CONTAINER" 2>&1 >&2 || true
exit 1
