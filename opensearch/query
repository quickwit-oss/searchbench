#!/usr/bin/env bash
# Run one OpenSearch query; timing on stderr.
#
# stdin = one DSL body. stdout = result rows. stderr last line = curl
# %{time_total} secs: client round-trip, comparable across engines unlike
# server-side `took`.

set -euo pipefail

: "${OS_PORT:=9200}"
OS_URL="http://127.0.0.1:${OS_PORT}"
INDEX="${OS_INDEX:-otel_logs}"

# request_cache=false is belt-and-braces only: config/index_mapping.json already
# sets index.requests.cache.enable=false, and re-running with this parameter
# changed no timing beyond run-to-run noise. The residual cold/hot ratio is page
# cache and JVM warm-up, not a result cache.
q=$(cat)

# SEARCHBENCH_OS_METRICS_LOG=<file>: one JSON line per query with node-stats deltas around the search
# (the timed request is unchanged):
#   gets / get_ms   the snapshot repository's S3 GetObject count and time
#   bytes           S3 bytes downloaded = growth of the searchable-snapshot file cache. Every remote
#                   read fetches whole blocks (8 MiB, the last block of a file shorter) into the cache,
#                   and nothing is evicted at this size, so the growth is exactly what was downloaded.
#   misses          file-cache misses (blocks fetched)
#   req_cache_hits / query_cache_hits / fielddata_mb  request, query and fielddata caches (the two
#                   caches are disabled; any hit would mean a result was served from memory)
#   net_rx          bytes received by the host network interfaces (S3 payloads + HTTP/TLS overhead)
fc() { curl -fsS "$OS_URL/_nodes/_local/stats" 2>/dev/null | jq -c '.nodes[] |
    {gets: ([.repositories[]?.request_success_total.GetObject // 0] | add // 0),
     get_ms: ([.repositories[]?.request_time_in_millis.GetObject // 0] | add // 0),
     misses: (.aggregate_file_cache.miss_count // 0), used: (.aggregate_file_cache.used_in_bytes // 0),
     rq: (.indices.request_cache.hit_count // 0), qc: (.indices.query_cache.hit_count // 0),
     fd: (.indices.fielddata.memory_size_in_bytes // 0)}'; }
rx() { awk -F'[: ]+' '$0 ~ /:/ && $2 != "lo" {s += $3} END {printf "%d", s}' /proc/net/dev 2>/dev/null || echo 0; }
if [[ -n "${SEARCHBENCH_OS_METRICS_LOG:-}" ]]; then fc0=$(fc); rx0=$(rx); fi
# -w appends round-trip secs on final line
resp=$(curl -fsS -w '\n%{time_total}' -X POST "$OS_URL/$INDEX/_search?request_cache=false&allow_partial_search_results=false" \
    -H 'Content-Type: application/json' --data-binary "$q")
rt=$(printf '%s\n' "$resp" | tail -n1)
if [[ -n "${SEARCHBENCH_OS_METRICS_LOG:-}" ]]; then
    rx1=$(rx)
    jq -cn --arg sha "$(printf '%s' "$q" | sha1sum | cut -c1-12)" --argjson t "$rt" \
        --argjson a "${fc0:-null}" --argjson b "$(fc)" --argjson rx $((rx1 - rx0)) \
        '{query_sha1: $sha, time: $t, gets: ($b.gets - $a.gets), get_ms: ($b.get_ms - $a.get_ms),
          bytes: ($b.used - $a.used), misses: ($b.misses - $a.misses), cache_used_after: $b.used,
          req_cache_hits: ($b.rq - $a.rq), query_cache_hits: ($b.qc - $a.qc), fielddata_mb: ($b.fd / 1048576),
          net_rx: $rx}' >> "$SEARCHBENCH_OS_METRICS_LOG" || true
fi
body=$(printf '%s\n' "$resp" | sed '$d')

# Every shard must have answered: a partial result is a wrong count, not a timing.
if ! jq -e '._shards.failed == 0 and ._shards.successful == ._shards.total' <<<"$body" >/dev/null; then
    echo "partial result: $(jq -c ._shards <<<"$body")" >&2; exit 1
fi
# Emit rows per response shape, so every query type yields comparable non-empty result:
#   * group_by     -> agg buckets ({key, doc_count})  [size:0 + aggs]
#   * top_k/recent -> hit _source rows                [size:N, hits]
#   * count        -> total hit count                 [size:0, no aggs]
# Top-level buckets only (no nested sub-aggs): multi-key GROUP BY like Q41 reports outer-key buckets only.
jq -c '
  if (.aggregations != null) then
    (.aggregations | to_entries[] | .value.buckets[]? | {key: (.key_as_string // .key), doc_count})
  elif ((.hits.hits | length) > 0) then
    .hits.hits[]._source
  else
    .hits.total.value
  end
' <<<"$body"
printf '%s\n' "$rt" >&2
