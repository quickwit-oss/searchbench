#!/usr/bin/env bash
# Exit 0 when OS can answer queries over the WHOLE index on $OS_PORT; non-zero otherwise.
#
# Green, not yellow: yellow only means the primaries of a single-node cluster's
# indices are allocated, not started. After a restart, the shards of a remote_snapshot
# (S3) index start one by one over ~a minute; a query sent meanwhile succeeds on the
# started shards and silently counts a fraction of the documents (a 16-shard 1B index
# answered 23.4M instead of 93.6M). No replicas here, so green = every primary started.
set -euo pipefail
: "${OS_PORT:=9200}"
curl -fsS "http://127.0.0.1:${OS_PORT}/_cluster/health?wait_for_status=green&timeout=2s" \
  | jq -e '.status == "green" and .initializing_shards == 0 and .unassigned_shards == 0' >/dev/null 2>&1
